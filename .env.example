# Copy to .env for local development. Do not commit real values.
APP_DATABASE_PATH=data/amazon_competitor.sqlite3
APP_BROWSER_HEADLESS=true
APP_BROWSER_BINARY=
APP_PAGE_TIMEOUT_SECONDS=30
APP_ELEMENT_TIMEOUT_SECONDS=10
APP_JOB_TIMEOUT_SECONDS=900
APP_MIN_NAVIGATION_INTERVAL_SECONDS=2
APP_MAX_QUEUE_SIZE=20
APP_MAX_SEARCH_PAGES=2
APP_MAX_SEARCH_QUERIES=3
APP_MAX_COMPETITORS=20
APP_OPENAI_MODEL=gpt-4o-mini
APP_STRICT_SQLITE_VERSION=false
OPENAI_API_KEY=
