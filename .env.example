# V2 local development. Copy to .env; never commit real credentials.
# Compose overrides this native SQLite URL with its internal PostgreSQL service.
APP_DATABASE_URL=sqlite+aiosqlite:///data/amazon_competitor_v2.db
APP_ENV=development
APP_EVIDENCE_DIR=evidence
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_PLAYWRIGHT_HEADLESS=true
APP_PAGE_TIMEOUT_SECONDS=30
APP_ELEMENT_TIMEOUT_SECONDS=10
APP_MIN_NAVIGATION_INTERVAL_SECONDS=5
APP_MAX_SEARCH_PAGES=2
APP_MAX_COMPETITORS=20
APP_BLOCK_COOLDOWN_SECONDS=300
APP_API_RATE_LIMIT_PER_MINUTE=5
APP_MAX_EVIDENCE_BYTES=5242880
APP_MAX_ANALYSIS_INPUT_BYTES=131072
APP_WORKER_POLL_INTERVAL=1
APP_WORKER_LEASE_SECONDS=90
APP_WORKER_HEARTBEAT_SECONDS=15
APP_GROQ_MODEL=openai/gpt-oss-20b
APP_GROQ_API_KEY=
# Local-only database password; use URL-safe characters if changing it.
POSTGRES_PASSWORD=aci_local

# Legacy V1 only: docker compose -p aci-v1 -f compose.v1.yaml up --build
APP_DATABASE_PATH=data/amazon_competitor.sqlite3
APP_BROWSER_HEADLESS=true
APP_BROWSER_BINARY=
APP_BROWSER_NO_SANDBOX=false
APP_BROWSER_DISABLE_DEV_SHM_USAGE=false
APP_SELENIUM_URL=
APP_BROWSER_RECOVERY_URL=
APP_BROWSER_VNC_PASSWORD=secret
APP_CHALLENGE_WAIT_SECONDS=300
APP_JOB_POLL_SECONDS=2
APP_JOB_TIMEOUT_SECONDS=900
APP_MAX_QUEUE_SIZE=20
APP_MAX_SEARCH_QUERIES=3
APP_STRICT_SQLITE_VERSION=false
GROQ_API_KEY=
