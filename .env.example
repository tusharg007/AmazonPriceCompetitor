# Copy to .env for local development. Do not commit real values.
APP_DATABASE_PATH=data/amazon_competitor.sqlite3
APP_BROWSER_HEADLESS=true
APP_BROWSER_BINARY=
APP_BROWSER_NO_SANDBOX=false
APP_BROWSER_DISABLE_DEV_SHM_USAGE=false
# Docker uses a visible Selenium browser and saves its profile in a named volume.
# For local Python execution, false opens a regular browser window for human checks.
APP_SELENIUM_URL=
APP_BROWSER_RECOVERY_URL=
APP_BROWSER_VNC_PASSWORD=secret
APP_CHALLENGE_WAIT_SECONDS=300
APP_BLOCK_COOLDOWN_SECONDS=300
APP_JOB_POLL_SECONDS=2
APP_PAGE_TIMEOUT_SECONDS=30
APP_ELEMENT_TIMEOUT_SECONDS=10
APP_JOB_TIMEOUT_SECONDS=900
APP_MIN_NAVIGATION_INTERVAL_SECONDS=5
APP_MAX_QUEUE_SIZE=20
APP_MAX_SEARCH_PAGES=2
APP_MAX_SEARCH_QUERIES=3
APP_MAX_COMPETITORS=20
APP_GROQ_MODEL=openai/gpt-oss-20b
APP_STRICT_SQLITE_VERSION=false
GROQ_API_KEY=
